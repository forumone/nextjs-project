{
  "name": "nextjs-project",
  "version": "2.3.6",
  "private": true,
  "scripts": {
    "predev": "npm run build-icons",
    "dev": "concurrently \"npm run watch\" \"next dev --webpack\"",
    "prebuild": "npm run build-icons",
    "build": "next build --webpack",
    "start": "next start",
    "export": "npm run build && next export",
    "typegen": "next typegen",
    "lint": "eslint \"app/**\" \"source/**\" \"util/**\" && stylelint \"source/**/*.css\"",
    "prepare": "husky",
    "prettier": "prettier --check app source/",
    "prettier:write": "prettier --write app source/",
    "tsc": "tsc --noEmit",
    "test": "npm run typegen && npm run lint && npm run tsc",
    "component": "node lib/create-component.mjs",
    "prestorybook": "npm run build-icons",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build-icons",
    "build-storybook": "storybook build -o storybook-static",
    "build-icons": "node lib/generate-icon-manifest.mjs && node lib/generate-icon-sprite.mjs",
    "build-icons:force": "node lib/generate-icon-manifest.mjs --force && node lib/generate-icon-sprite.mjs --force",
    "watch": "npm-watch",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "pretest:e2e": "node lib/ensurePlaywrightBrowsers.mjs"
  },
  "watch": {
    "build-icons": {
      "patterns": [
        "source/01-global/icon/svgs"
      ],
      "extensions": "svg"
    }
  },
  "browserslist": [
    "last 2 versions and not dead",
    ">= 1%",
    ">= 1% in US"
  ],
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@forumone/eslint-config-es5": "^4.0.1",
    "@forumone/tiny-mustache": "^3.0.5",
    "@inquirer/prompts": "^8.7.3",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "css-loader": "^7.1.5",
    "csstype": "3.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.1",
    "html-react-parser": "^6.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.29",
    "postcss-advanced-variables": "github:kmonahan/postcss-advanced-variables",
    "postcss-import": "^16.2.0",
    "postcss-loader": "^8.2.1",
    "postcss-nesting": "^14.0.3",
    "postcss-preset-env": "^11.6.1",
    "postcss-rem": "^3.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "^10.6.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-webpack-plugin": "^5.1.0",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "csstype": "3.2.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "storybook": "$storybook"
  },
  "engines": {
    "node": "24"
  }
}
